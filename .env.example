# ScoutAgent — Concordium TESTNET configuration (copy to .env, never commit .env)

# Network: testnet | mainnet  (hackathon build targets testnet)
NETWORK=testnet

# Public testnet node, gRPC v2 / gRPC-web, TLS — docs.concordium.com "Set up the
# development environment": grpc.testnet.concordium.com, port 20000
CCD_NODE_HOST=grpc.testnet.concordium.com
CCD_NODE_PORT=20000

# Hosted Agent Registry services (mainnet, testnet and devnet configured) —
# docs.concordium.com/en/mainnet/technical-reference/agent-registry/mcp-service.html
MCP_BASE_URL=https://agent-registry-mcp.concordium.com
INDEXER_BASE_URL=https://agent-registry-indexer.concordium.com

# Owner account (created from a TESTNET identity — no real ID documents needed,
# see BUILD-PLAN.md). Keys come from the wallet export file
# (<ACCOUNT ADDRESS>.export) produced by Concordium Wallet for Web.
OWNER_ACCOUNT=
ACCOUNT_EXPORT_FILE=

# Filled in after registration:
# Badge = CIS-8004 NFT token address, Base58Check short form (e.g. Mf22...)
SCOUT_AGENT_BADGE=
# Public URL where agent-card/agent-card.json is hosted (its SHA-256 is pinned
# on-chain via setAgentURI after registration)
AGENT_CARD_URL=
